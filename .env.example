# Salin jadi .env.local (untuk laptop) dan isi juga di Vercel → Settings → Environment Variables.
# JANGAN commit .env.local.

# Supabase → Project Settings → API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Supabase → Connect → ORMs / Drizzle → "Transaction pooler" (port 6543). RAHASIA.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Email yang boleh masuk /admin, pisahkan dengan koma.
ADMIN_EMAILS=ranni@example.com,admin-kedua@example.com

# Rahasia untuk Vercel Cron (/api/keepalive), string acak minimal 16 karakter. RAHASIA.
CRON_SECRET=ganti-dengan-string-acak
